{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env --import tsx src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/rating.test.ts test/texts.test.ts test/finn.test.ts test/sun.test.ts",
    "test:addresses": "node --import tsx --test test/addresses.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@duckdb/node-api": "^2.0.0-r.1",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "playwright-core": "^1.65.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
